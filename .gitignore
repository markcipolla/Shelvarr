# Dependencies
node_modules/

# Build output
dist/

# Data directory (contains database)
data/

# Environment files
.env
.env.local
.env.*.local

# Logs
# Anchored: an unanchored `logs/` also swallows source directories named
# `logs`, such as the /api/admin/logs route.
/logs/
*.log
npm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test artifacts
test-results/
playwright-report/
coverage/
# Throwaway database the E2E run creates its first admin account in. The
# suffixed variants are what a sharded or hand-run second suite uses, named
# after the port it picked — see apps/web/playwright.config.js.
apps/web/tests/.e2e-data/
apps/web/tests/.e2e-data-*/

# Temp files
*.tmp
*.temp
.cache/
.next/

# pnpm
.pnpm-store/

# Signing keys — never commit these. apps/native/.gitignore covers some of
# these patterns, but only within that directory, so a key left at the repo
# root would otherwise be committable.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
