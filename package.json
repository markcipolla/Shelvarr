{
  "name": "shelvarr-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted *arr-style app for book/comic metadata management and file organization",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @shelvarr/web dev",
    "dev:server": "pnpm --filter @shelvarr/server dev",
    "dev:native": "pnpm --filter @shelvarr/native start",
    "dev:native:ios": "pnpm --filter @shelvarr/native ios",
    "dev:native:android": "pnpm --filter @shelvarr/native android",
    "build:native:android": "cd apps/native && npx expo export && cd android && ./gradlew assembleRelease",
    "deploy:native:android": "adb -s ec5ae1ec install -r apps/native/android/app/build/outputs/apk/release/app-release.apk",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "komga",
    "books",
    "ebooks",
    "comics",
    "metadata",
    "library",
    "self-hosted"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
