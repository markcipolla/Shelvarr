{
  "name": "shelvarr",
  "version": "0.0.1",
  "description": "Self-hosted *arr-style app for book/comic metadata management and file organization",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:all": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "komga",
    "books",
    "ebooks",
    "comics",
    "metadata",
    "library",
    "self-hosted"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "next": "^16.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.8",
    "autoprefixer": "^10.4.23",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
