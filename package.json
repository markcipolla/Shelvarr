{
  "name": "komgarr",
  "version": "0.0.1",
  "description": "Self-hosted *arr-style app for book/comic metadata management and file organization",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run css:build",
    "build:ts": "tsc",
    "test": "tsx --test tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "c8 npm test",
    "css:build": "tailwindcss -i ./src/public/css/styles.css -o ./dist/public/css/styles.css",
    "css:watch": "tailwindcss -i ./src/public/css/styles.css -o ./dist/public/css/styles.css --watch",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "komga",
    "books",
    "ebooks",
    "comics",
    "metadata",
    "library",
    "self-hosted"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
