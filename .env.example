# Copy to .env next to docker-compose.yml and fill in what you need.
# Every line is optional: delete the ones you are not setting rather than
# leaving them blank, since blank means "use the default".

# The user that owns your library folders, and the zone timestamps are shown
# in. `id -u` and `id -g` on the host give you the first two.
# PUID=1000
# PGID=1000
# TZ=Australia/Melbourne

# Accounts are on by default. false leaves the server open — trusted network
# or a reverse proxy that already authenticates, only. The toggle in
# Settings -> Users wins once an admin sets it.
# SHELVARR_AUTH_ENABLED=false
# Self-signup. The toggle in Settings -> Users wins once an admin sets it.
# SHELVARR_ALLOW_SIGNUP=false

# Mail server for sign-in codes. Without SMTP_HOST, codes are written to the
# server log and invite codes are shown in Settings -> Users. These are the
# starting values; the form in Settings -> Users wins once an admin saves it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Implicit TLS. Defaults to on for port 465 and off otherwise; set this only
# if your server disagrees.
# SMTP_SECURE=true
SMTP_USER=shelvarr@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=Shelvarr <shelvarr@example.com>
