{
  "name": "@shelvarr/native",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild --platform android",
    "build": "export EXPO_PUBLIC_BUILD_VERSION=${EXPO_PUBLIC_BUILD_VERSION:-$(git rev-parse --short HEAD 2>/dev/null || echo dev)} && cd android && ./gradlew assembleRelease",
    "deploy": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "bd": "npm run build && npm run deploy",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__"
  },
  "dependencies": {
    "@openspacelabs/react-native-zoomable-view": "^2.4.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@shelvarr/types": "workspace:*",
    "@types/base-64": "^1.0.2",
    "axios": "^1.18.0",
    "base-64": "^1.0.0",
    "expo": "~54.0.33",
    "expo-file-system": "~19.0.21",
    "expo-image": "~3.0.9",
    "expo-intent-launcher": "~13.0.8",
    "expo-font": "^55.0.4",
    "expo-sqlite": "~16.0.10",
    "expo-navigation-bar": "^55.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "jszip": "^3.10.1",
    "lodash": "^4.17.23",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.24.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pdf": "^7.0.4",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "better-sqlite3": "^12.6.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.1"
