# Test environment variables

# Turn off the pauses the services take to stay inside third-party rate limits
# (see packages/services/src/utils/pacing.ts). Nothing here talks to a real API
# — tests/no-network.mjs sees to that — so every one of those pauses is real
# time spent waiting on a mock. Leaving them on cost the suite about a minute.
SHELVARR_DISABLE_REQUEST_PACING=1

# Keep logs in memory. Without this every test that imports lib/config would
# append to a log file under its DATA_DIR; the log-file tests open their own.
LOG_FILE=off
